{
  "name": "voicehistory",
  "version": "0.1.16",
  "description": "Local-first archive for recorded phone calls: imports Cube ACR exports, transcribes speech with whisper.cpp, and makes years of conversations searchable. Nothing leaves your machine.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node cli/vh.js serve",
    "serve": "node cli/vh.js serve",
    "import": "node cli/vh.js import",
    "transcribe": "node cli/vh.js transcribe",
    "status": "node cli/vh.js status",
    "reindex": "node cli/vh.js reindex",
    "doctor": "node cli/vh.js doctor",
    "jobs": "node cli/vh.js jobs",
    "watch": "node cli/vh.js watch",
    "app": "node scripts/app.mjs",
    "test": "node --test",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "demo": "node scripts/demo-archive.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "whisper",
    "whisper-cpp",
    "transcription",
    "speech-to-text",
    "call-recording",
    "archive",
    "sqlite",
    "fts5",
    "local-first",
    "privacy"
  ],
  "author": "Alexey Fedyunin <alexey@cranfan.ru>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedyunin/voicehistory.git"
  },
  "bugs": {
    "url": "https://github.com/fedyunin/voicehistory/issues"
  },
  "homepage": "https://github.com/fedyunin/voicehistory#readme",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.0"
  },
  "main": "app/main.cjs",
  "build": {
    "appId": "ru.cranfan.voicehistory",
    "productName": "Voice History",
    "artifactName": "VoiceHistory-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "core/**/*",
      "cli/**/*",
      "scripts/setup.mjs",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VoiceHistory-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "VoiceHistory-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
